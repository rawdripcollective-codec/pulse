# ─── Pulse Environment Configuration ──────────────────────
#
# 1. Copy this file to `.env` and fill in real values before `docker compose up`.
# 2. NEVER commit your `.env` file. It is already in `.gitignore`.
# 3. For LLM provider presets, see `./envs/`:
#      - envs/anthropic.env.example  (cloud — Claude)
#      - envs/openai.env.example     (cloud — GPT-4o etc.)
#      - envs/ollama-local.env.example  (LOCAL — no API key needed)
#      - envs/ollama-cloud.env.example  (Ollama Cloud — needs API key)
#
# ─── LLM ─────────────────────────────────────────────────
# Provider: anthropic | openai | ollama
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-20250514
LLM_API_KEY=sk-ant-REPLACE_ME
# For Ollama: LLM_BASE_URL=http://host.docker.internal:11434/v1
# For Ollama Cloud: LLM_BASE_URL=https://ollama.com/v1
LLM_BASE_URL=

# ─── Embeddings ──────────────────────────────────────────
# For local Ollama, use the same base URL and set a local embedding model.
# For cloud providers, use voyage-code-2, text-embedding-3-small, etc.
EMBEDDING_MODEL=voyage-code-2
EMBEDDING_API_KEY=REPLACE_ME
# Override base URL for embeddings (defaults to LLM_BASE_URL if unset)
# EMBEDDING_BASE_URL=

# ─── GitHub Integration ──────────────────────────────────
# Step 1: Create an OAuth App at https://github.com/settings/developers
#         Homepage URL:         http://localhost:5173
#         Authorization callback: http://localhost:5173/auth/callback
# Step 2: Generate a Fine-grained PAT at https://github.com/settings/tokens
#         Minimum scopes: Contents:Read, Issues:RW, Pull requests:RW, Metadata:R
#         (Don't paste the PAT in chat or commit it. Put it here in .env only.)
GITHUB_CLIENT_ID=Ov23liREPLACE_ME
GITHUB_CLIENT_SECRET=REPLACE_ME
GITHUB_TOKEN=ghp_REPLACE_ME         # fine-grained PAT (used for REST + App auth)
GITHUB_WEBHOOK_SECRET=REPLACE_ME_WITH_RANDOM_STRING  # openssl rand -hex 32

# Optional: GitHub App credentials (alternative to OAuth for org-wide installs)
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=

# ─── Security ────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=REPLACE_ME_WITH_OPENSSL_RAND_HEX_32

# ─── Database & Cache ────────────────────────────────────
# These default to the docker-compose service hostnames; override for local dev.
DATABASE_URL=postgresql+asyncpg://pulse:pulse@postgres:5432/pulse
DATABASE_URL_SYNC=postgresql://pulse:pulse@postgres:5432/pulse
REDIS_URL=redis://redis:6379/0

# ─── Application ─────────────────────────────────────────
APP_NAME=Pulse
APP_VERSION=0.1.0
DEBUG=false

# ─── Indexing limits ─────────────────────────────────────
MAX_REPO_SIZE_BYTES=524288000     # 500 MB
MAX_FILE_SIZE_BYTES=2097152       # 2 MB per file
