# ─── Pulse Environment Configuration ──────────────────────
# Copy this file to `.env` and fill in real values before `docker compose up`.

# ─── LLM ─────────────────────────────────────────────────
# Provider: anthropic | openai | ollama
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-20250514
LLM_API_KEY=sk-ant-...
# For Ollama (local), set this to your local server:
# LLM_BASE_URL=http://host.docker.internal:11434/v1

# ─── Embeddings ──────────────────────────────────────────
EMBEDDING_MODEL=voyage-code-2
EMBEDDING_API_KEY=...

# ─── GitHub Integration ──────────────────────────────────
# Create an OAuth App at https://github.com/settings/developers
# Callback URL: http://localhost:5173/auth/callback
GITHUB_CLIENT_ID=Ov23li...
GITHUB_CLIENT_SECRET=...
# Any random secret for HMAC webhook signature verification
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Optional: GitHub App credentials (alternative to OAuth for org-wide installs)
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=

# ─── Security ────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-with-openssl-rand-hex-32

# ─── Database & Cache ────────────────────────────────────
# These default to the docker-compose service hostnames; override for local dev.
DATABASE_URL=postgresql+asyncpg://pulse:pulse@postgres:5432/pulse
DATABASE_URL_SYNC=postgresql://pulse:pulse@postgres:5432/pulse
REDIS_URL=redis://redis:6379/0

# ─── Application ─────────────────────────────────────────
APP_NAME=Pulse
APP_VERSION=0.1.0
DEBUG=false

# ─── Indexing limits ─────────────────────────────────────
MAX_REPO_SIZE_BYTES=524288000     # 500 MB
MAX_FILE_SIZE_BYTES=2097152       # 2 MB per file
