# ─── Ollama CLOUD preset ───────────────────────────────────
#
# Use this if you're using Ollama's hosted service at https://ollama.com
# (not the same as running Ollama locally — this DOES require an API key.)
#
# Get an API key: https://ollama.com/settings/keys
#
# Copy the block below into your `.env` and fill in the values.

# LLM
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5-coder:32b                  # or whatever you have on Ollama Cloud
LLM_API_KEY=REPLACE_ME                       # ← your Ollama Cloud key goes here
LLM_BASE_URL=https://ollama.com/v1

# Embeddings
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_API_KEY=REPLACE_ME                 # ← same key
EMBEDDING_BASE_URL=https://ollama.com/v1
