# ─── OpenAI preset ─────────────────────────────────────────
#
# Get an API key: https://platform.openai.com/api-keys
# Pricing:        https://openai.com/pricing
#
# Copy the LLM/Embedding block below into your `.env` and fill in the values.

# LLM
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=sk-REPLACE_ME
LLM_BASE_URL=                              # leave empty for OpenAI SaaS

# Embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=sk-REPLACE_ME            # can be the same as LLM_API_KEY
