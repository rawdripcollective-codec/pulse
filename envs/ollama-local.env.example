# ─── Ollama (LOCAL) preset ─────────────────────────────────
#
#  ★ NO API KEY NEEDED ★
#
# 1. Install Ollama:    https://ollama.com/download
# 2. Pull a model:      ollama pull llama3.1        (or codellama, qwen2.5-coder, etc.)
#    For embeddings:    ollama pull nomic-embed-text
# 3. Make sure it's running: `ollama serve` (or it runs in the background on macOS/Linux)
# 4. Copy the block below into your `.env`.
#
# The `host.docker.internal` hostname lets the backend container reach Ollama
# running on your host machine. On Linux you may need to use `172.17.0.1` instead.

# LLM
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1                          # or: qwen2.5-coder, codellama, mistral
LLM_API_KEY=ollama                           # placeholder; Ollama ignores it
LLM_BASE_URL=http://host.docker.internal:11434/v1

# Embeddings (Ollama serves these too)
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_API_KEY=ollama                     # placeholder
EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
