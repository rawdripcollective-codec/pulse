# ─── Anthropic (Claude) preset ──────────────────────────────
#
# Get an API key: https://console.anthropic.com/settings/keys
# Pricing:        https://anthropic.com/pricing
#
# Copy the LLM/Embedding block below into your `.env` and fill in the values.

# LLM
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-20250514
LLM_API_KEY=sk-ant-REPLACE_ME
LLM_BASE_URL=                              # leave empty for Anthropic SaaS

# Embeddings (Anthropic does not host embeddings — pick one)
EMBEDDING_MODEL=voyage-code-2               # recommended for code
EMBEDDING_API_KEY=REPLACE_ME
# Or, with OpenAI:
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=sk-...
